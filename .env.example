# Copier en .env.local pour le développement. En production : Vercel → Settings → Environment Variables.

# Resend — emails du formulaire de contact
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_FROM_EMAIL=contact@linsaem.fr
CONTACT_TO_EMAIL=contact@linsaem.fr

# Cloudflare Turnstile — anti-robot du formulaire
# Clés de test Cloudflare (toujours valides) pour le développement :
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — limite d'envois par adresse IP
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Portail client Stripe (lien de connexion sans code). Lu au build : /login et /dashboard y redirigent.
STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/xxxxxxxx
